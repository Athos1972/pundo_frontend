#!/usr/bin/env bash
# F8950 T34: Pre-Push-Gate. Ein Push auf main deployt per Webhook nach Prod, deshalb laeuft vorher das volle Frontend-Gate
# (tsc, eslint, lint:i18n, Vitest, Playwright voll, npm audit, gitleaks falls installiert).
#
# Das Gate laeuft ISOLIERT (F8970 Worktree-Umgebungen): `scripts/worktree-env verify-push --repo frontend` legt aus dem
# gepushten Commit einen sauberen Worktree an, belegt einen freien Slot (eigene Ports 3511-3515, eigene Datenbank, eigener
# Mail-Sink) und fuehrt dort `scripts/test-gate.sh push` aus. Es beruehrt weder 3500/8500 noch den Arbeitsbaum; ein fremder
# `next dev`, ein fremder Playwright-Lauf oder uncommittete Dateien koennen den Push nicht mehr stoeren.
#
#   Aktivieren (einmal je Klon):   git config core.hooksPath .githooks      (oder: scripts/install-hooks.sh)
#   Deaktivieren:                  git config --unset core.hooksPath
#   Ausnahme im Notfall:           git push --no-verify   (nur mit Bernhards Freigabe und Grund in der Commit-/Handoff-Notiz)
#
# Voraussetzung: das Backend-Repo (Default ../pundo_main_backend, oder PUNDO_BACKEND_REPO) mit dem Controller
# scripts/worktree-env in einer Version, die den Lauf `frontend-push` kennt (git pull dort). Es braucht einen freien Slot
# (bis zu 5); ist keiner frei, bricht der Push mit einer klaren Meldung ab.
# Verhalten: nur Pushes, die refs/heads/main aktualisieren, werden geprueft; Branch-Loeschungen und andere Refs laufen durch.
# Fail-closed: Controller fehlt oder zu alt, kein freier Slot, Datenbank nicht erreichbar oder Timeout -> Push wird abgelehnt.
# Hinweis fuer Agents: Der Lauf dauert ca. 5 bis 8 min (Slot, Rebuild des Frontends); Tool-Timeout entsprechend hoch setzen.
set -u
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZERO="0000000000000000000000000000000000000000"
sha=""
while read -r _lref lsha rref _rsha; do
  [ "$rref" = "refs/heads/main" ] || continue
  [ "$lsha" = "$ZERO" ] && continue
  sha="$lsha"
done

if [ -z "$sha" ]; then
  echo "pre-push: kein Push auf main, Gate uebersprungen." >&2
  exit 0
fi

BACKEND_ROOT="${PUNDO_BACKEND_REPO:-$(cd "$ROOT/.." && pwd)/pundo_main_backend}"
CONTROLLER="$BACKEND_ROOT/scripts/worktree-env"
if [ ! -x "$CONTROLLER" ] || ! grep -q "frontend-push" "$BACKEND_ROOT/scripts/worktree_env.py" 2>/dev/null; then
  echo "pre-push: Controller fehlt oder ist zu alt ($CONTROLLER). Im Backend-Repo 'git pull' ausfuehren (oder PUNDO_BACKEND_REPO setzen). Fail-closed." >&2
  exit 4
fi

echo "pre-push: Push auf main (${sha:0:10}): isoliertes Frontend-Gate im freien Slot (Umgehen nur mit --no-verify und Grund)." >&2
PUNDO_BACKEND_REPO="$BACKEND_ROOT" PUNDO_FRONTEND_REPO="$ROOT" "$CONTROLLER" verify-push --repo frontend --sha "$sha" </dev/null
rc=$?
if [ "$rc" != 0 ]; then
  echo "pre-push: Gate ROT (rc=$rc). Push abgebrochen. Logs und Details stehen oben." >&2
fi
exit "$rc"
