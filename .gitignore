# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

graphify-out
.graphifyignore

.claude/*.lock

# testing
/coverage

/smoketests/node_modules/

# next.js
/.next/
/out/

/.idea/

test-results/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# signup data
data/naidivse-signups.txt

# Specs migrated to Obsidian vault on 2026-04-25 (Pundo-Plattform)
specs/
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# Guide image sources (LLM originals — gitignored, only optimised assets are committed)
content/guides/_raw/*
!content/guides/_raw/.gitkeep

# Unoptimised hero images in public/ — use `npm run guides:optimize` instead
public/images/guides/*.png
public/images/guides/*.jpg

# SEO audit / perf reports (scripts/seo-audit.ts, scripts/seo-perf.ts) —
# generated locally or in CI, uploaded as workflow artifacts, not committed.
# See .github/workflows/seo-audit.yml (B6400-008).
seo-audit-*.json
seo-audit-*.md
perf-report-*.json
perf-report-*.md
seo-perf-followups.md

# video pipeline
video/.venv/
video/**/out/
video/**/.cache/
video/**/.recording-accounts.json
video/**/cover-candidates/
video/**/photo-candidates/
video/_branding/pronunciation-test/

# E2E runtime state (contains test JWTs) — B8950-012
/e2e/.test-state.json
# Admin-storageState (Test-JWT) — F8950 (test-results/ ist oben schon ignoriert)
/e2e/.auth/

# F8950 T34: Nachweis des letzten Gate-Laufs (lokal, nicht committen)
.claude/playbooks/state/test-gate*.last_run

# E2E-Coverage (docs/e2e-testing.md "Coverage"): eigener Build + Rohdaten/Berichte
/.next-cov/
/coverage-e2e/

# Journey-Reports sind lokale Laufartefakte (jeder Playwright-Lauf schreibt sie neu), nicht versionieren (BB 2026-10-16)
e2e/journeys/reports/*
!e2e/journeys/reports/.gitkeep
