# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

graphify-out
.graphifyignore

.claude/*.lock

# testing
/coverage

/smoketests/node_modules/

# next.js
/.next/
/out/

/.idea/

test-results/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# signup data
data/naidivse-signups.txt

# Specs migrated to Obsidian vault on 2026-04-25 (Pundo-Plattform)
specs/
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# Guide image sources (LLM originals — gitignored, only optimised assets are committed)
content/guides/_raw/*
!content/guides/_raw/.gitkeep

# Unoptimised hero images in public/ — use `npm run guides:optimize` instead
public/images/guides/*.png
public/images/guides/*.jpg

# SEO audit / perf reports (scripts/seo-audit.ts, scripts/seo-perf.ts) —
# generated locally or in CI, uploaded as workflow artifacts, not committed.
# See .github/workflows/seo-audit.yml (B6400-008).
seo-audit-*.json
seo-audit-*.md
perf-report-*.json
perf-report-*.md
seo-perf-followups.md
