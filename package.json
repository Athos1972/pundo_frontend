{
  "name": "pundo_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:test": "BACKEND_URL=http://localhost:8500 next dev -H 0.0.0.0 -p 3500",
    "dev:test:poll": "NEXT_DEV_POLL_INTERVAL_MS=2000 npm run dev:test",
    "build": "next build",
    "build:prod": "next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "next start",
    "lint": "eslint",
    "videos:stale": "node scripts/video-staleness.mjs",
    "test:e2e:coverage": "node scripts/e2e-coverage.mjs",
    "test:e2e:coverage:report": "node scripts/e2e-coverage.mjs report",
    "lint:i18n": "tsx scripts/check-i18n-parity.ts",
    "lint:mdx-links": "tsx scripts/check-mdx-links.ts",
    "fix:mdx-links": "tsx scripts/fix-mdx-links.ts",
    "build:analyze": "ANALYZE=true next build",
    "guides:optimize": "tsx scripts/optimize-guide-images.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "seo:perf": "tsx scripts/seo-perf.ts",
    "blog:sync": "tsx scripts/sync-blog.ts",
    "blog:backfill": "tsx scripts/sync-blog.ts --backfill",
    "backfill:categories": "tsx scripts/backfill-featured-categories.ts",
    "seed-visuals:generate": "node scripts/generate-seed-visuals.mjs",
    "seed-visuals:generate:skip-existing": "node scripts/generate-seed-visuals.mjs --skip-existing",
    "seed-visuals:build": "node scripts/build-seed-visuals.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "browser-image-compression": "^2.0.2",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "next": "~16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@next/bundle-analyzer": "~16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.4.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.4.0",
    "monocart-coverage-reports": "^3.0.0",
    "postcss-nesting": "^14.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "vite": "^8.3.5",
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  }
}
